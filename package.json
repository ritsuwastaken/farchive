{
    "name": "@ritsuwastaken/farchive",
    "version": "1.0.4",
    "description": "reader and writer for unreal engine 1, 2 and 3 binary data",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "farchive",
        "archive",
        "serialization",
        "compact index",
        "fstring",
        "binary",
        "typescript",
        "javascript",
        "unreal",
        "ue",
        "ue2",
        "ue3"
    ],
    "author": "ritsuwastaken",
    "license": "Unlicense",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ritsuwastaken/farchive.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test \"test/**/*.test.ts\"",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "7.0.2"
    }
}
